 *
 * STM3210E-EVAL — STMicroelectronics evaluation board with STM32F103ZGT6.
 *
 * Pin assignments derived from ST BSP (stm3210e_eval.h) and UM0455 / MB672.
 * Target MCU: STM32F103ZGT6 (1 MiB Flash, 96 KiB SRAM, Cortex-M3 @ 72 MHz).
 * Older MB672 revisions may ship STM32F103ZET6 (512 KiB / 64 KiB) — use a
 * board variant/overlay if required.
 */

/dts-v1/;
#include <st/f1/stm32f103Xg.dtsi>
#include <st/f1/stm32f103z(f-g)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "STMicroelectronics STM3210E-EVAL board";
	compatible = "st,stm3210e-eval";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		/* Standalone builds link into this single region (whole flash). */
		zephyr,code-partition = &code_partition;
		zephyr,display = &mb895_lcd;
	};

	/* RV1 pot + BNC analogs (UM0488 CN2/CN3/CN5 → PC1–PC3). */
	zephyr,user {
		io-channels = <&adc1 14>, <&adc1 11>, <&adc1 12>, <&adc1 13>;
		dac = <&dac1>;
		dac-channel-id = <1>;
		dac-resolution = <12>;
	};

	/* MB895 TFT on CN16 — FSMC bank4 + Zephyr display API. */
	mb895_lcd: mb895-lcd {
		compatible = "zplatform,mb895-lcd";
		/* 320×240 landscape — matches Cube HX8347D window (cols 0..319, rows 0..239). */
		width = <320>;
		height = <240>;
		pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
		status = "okay";
	};

	/*
	 * IS61WV51216BLL — 512K×16 on FSMC bank1 NOR/PSRAM3.
	 * Access after zplatform_fsmc_sram_init() (CONFIG_ZPLATFORM_FSMC_SRAM).
	 */
	ext_sram: sram@68000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x68000000 DT_SIZE_K(1024)>;
		zephyr,memory-region = "EXT_SRAM";
	};

	leds {
		compatible = "gpio-leds";

		green_led_1: led_1 {
			gpios = <&gpiof 6 GPIO_ACTIVE_HIGH>;
			label = "User LD1";
		};

		orange_led_2: led_2 {
			gpios = <&gpiof 7 GPIO_ACTIVE_HIGH>;
			label = "User LD2";
		};

		red_led_3: led_3 {
			gpios = <&gpiof 8 GPIO_ACTIVE_HIGH>;
			label = "User LD3";
		};

		blue_led_4: led_4 {
			gpios = <&gpiof 9 GPIO_ACTIVE_HIGH>;
			label = "User LD4";
		};
	};

	/* TIM1_CH1 (PA8) — exposed on CN10 / motor-control path; no on-board LED. */
	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm1 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "TIM1_CH1 PA8";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_key {
			label = "User Key";
			gpios = <&gpiog 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		tamper_button: button_tamper {
			label = "Tamper";
			gpios = <&gpioc 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_1>;
		};

		/* JP4 open: Wakeup B2 (not USART2 CTS / motor-control) */
		wakeup_button: button_wakeup {
			label = "Wakeup";
			gpios = <&gpioa 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			zephyr,code = <INPUT_KEY_WAKEUP>;
		};

		/* Joystick U19 — UM0455 / MB672 */
		joy_up: button_joy_up {
			label = "Joystick Up";
			gpios = <&gpiog 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_UP>;
		};

		joy_down: button_joy_down {
			label = "Joystick Down";
			gpios = <&gpiod 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_DOWN>;
		};

		joy_left: button_joy_left {
			label = "Joystick Left";
			gpios = <&gpiog 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		joy_right: button_joy_right {
			label = "Joystick Right";
			gpios = <&gpiog 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_RIGHT>;
		};

		joy_select: button_joy_select {
			label = "Joystick Select";
			gpios = <&gpiog 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};

	aliases {
		led0 = &green_led_1;
		led1 = &orange_led_2;
		led2 = &red_led_3;
		led3 = &blue_led_4;
		pwm-led0 = &pwm_led0;
		lcd0 = &mb895_lcd;
		sw0 = &user_button;
		sw1 = &tamper_button;
		sw-wakeup = &wakeup_button;
		joy-up = &joy_up;
		joy-down = &joy_down;
		joy-left = &joy_left;
		joy-right = &joy_right;
		joy-select = &joy_select;
		watchdog0 = &iwdg;
		die-temp0 = &die_temp;
		rtc = &rtc;
		mcuboot-button0 = &user_button;
	};
};

&clk_lsi {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	mul = <9>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(72)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "disabled";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* STLM75 temperature sensor on the evaluation board */
	stlm75: stlm75@48 {
		compatible = "lm75";
		reg = <0x48>;
		status = "okay";
	};
};

&spi1 {
	pinctrl-0 = <&spi1_sck_master_pa5 &spi1_miso_master_pa6
		     &spi1_mosi_master_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;
	status = "okay";

	/*
	 * U6 M25P64-VME6G (64 Mbit). CS = PB2.
	 * JP3 must route SPI1 MISO to the serial Flash (see UM0455).
	 */
	m25p64: m25p64@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		jedec-id = [20 20 17];
		size = <DT_SIZE_M(64)>; /* 64 Mbit = 8 MiB */
		status = "okay";
	};
};

&iwdg {
	status = "okay";
};

&timers1 {
	st,prescaler = <7199>;
	status = "okay";

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pwm_out_pa8>;
		pinctrl-names = "default";
	};
};

zephyr_udc0: &usb {
	pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
	pinctrl-names = "default";
	/*
	 * USB FS shares IRQs 19/20 with bxCAN (RM0008). Default: USB live,
	 * CAN disabled. samples/can (and demo overlay) flip that.
	 */
	status = "okay";
};

&can1 {
	pinctrl-0 = <&can_rx_remap1_pb8 &can_tx_remap1_pb9>;
	pinctrl-names = "default";
	/* SN65HVD230 on CN4 — PB8/PB9 remap1 (UM0488 §2.7). */
	status = "disabled";

	can-transceiver {
		max-bitrate = <1000000>;
	};
};

&dac1 {
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 28)>,
		 <&rcc STM32_SRC_LSI RTC_SEL(2)>;
	status = "okay";
};

&adc1 {
	/* RV1 PC4=IN14; BNC CN5/CN3/CN2 = PC1/PC2/PC3 = IN11/IN12/IN13 */
	pinctrl-0 = <&adc1_in14_pc4 &adc1_in11_pc1 &adc1_in12_pc2
		     &adc1_in13_pc3>;
	pinctrl-names = "default";
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@e {
		reg = <14>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};

	channel@b {
		reg = <11>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};

	channel@c {
		reg = <12>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};

	channel@d {
		reg = <13>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};
};

&die_temp {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Standalone / default image: one partition = entire Flash.
		 * MCUboot builds replace this node via
		 * support/partitions_mcuboot.dtsi (boot / slot0 / slot1 / storage).
		 */
		code_partition: partition@0 {
			label = "code";
			reg = <0x00000000 DT_SIZE_K(1024)>;
		};
	};
};
